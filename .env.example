# =============================================================================
# VOLTA - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# --- API Key (static key for backend API access) ---
# Generate with: openssl rand -hex 32
API_KEY="generate_with_openssl_rand_hex_32"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate_with_openssl_rand_base64_32"

# --- JWT Secret (for backend JWT tokens) ---
# Generate with: openssl rand -hex 32
BACKEND_JWT_SECRET="generate_with_openssl_rand_hex_32"

# --- LOPD HMAC Secret (for LOPD consent tokens, MUST be different from JWT secret) ---
# Generate with: openssl rand -hex 32
LOPD_HMAC_SECRET="generate_with_openssl_rand_hex_32"

# --- Server ---
PORT=3000
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development

# --- Redis Queue & Cache Infrastructure ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
