# =============================================================================
# VOLTA - Configuración de Desarrollo (.env)
# =============================================================================
# Copia este archivo a .env y sustituye TODOS los secretos por valores propios.
# Los valores de abajo son marcadores de posición: nunca uses estos en producción.

# --- Base de Datos ---
DATABASE_URL=postgresql://volta_user:volta_password@localhost:5432/volta_db?schema=public

# --- Comunicación Interna (API Key) ---
API_KEY=volta_dev_api_key_8f91c7a2e4b6d3f0

# --- Seguridad de Sesiones (NextAuth) ---
AUTH_SECRET=pY3gK91lMnR7tVwXz2aB5cD8eF1gH4iJ7kL0mN3oP6q=

# --- Tokens del Backend (JWT) ---
BACKEND_JWT_SECRET=e7b92f41d08c6a351e94072f8a3b5c6d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b

# --- Firma de LOPD (HMAC) ---
LOPD_HMAC_SECRET=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e

# --- Sesion de reserva publica (JWT) ---
# Firma el token que recibe el visitante tras verificar su telefono por WhatsApp.
# Debe ser distinto de BACKEND_JWT_SECRET: acredita a un anonimo, no a un usuario.
BOOKING_JWT_SECRET=3c1f8b47e29d05a6c8b3f1e7d492a0b5c6d8e1f3a7b9c2d4e6f8a0b1c3d5e7f9

# --- Configuración de Red y Servidor ---
PORT=3000
PORT_HOST=3001
HOSTNAME=0.0.0.0
FRONTEND_URL=http://localhost:3000/
NODE_ENV=development

# --- Redis Infraestructura de Colas y Caché ---
# Opción A (Recomendada): REDIS_URL=redis://:password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Pasarela de Pagos y Suscripciones (Lemon Squeezy - Merchant of Record) ---
# Opcional en desarrollo local (el sistema activa modo de prueba simulado si no están presentes)
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here
LEMONSQUEEZY_VARIANT_BASIC=your_variant_id_for_basic_plan
LEMONSQUEEZY_VARIANT_PRO=your_variant_id_for_pro_plan

