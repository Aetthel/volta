# Volta - Production Environment Variables
# Copy this file to .env.prod and fill in the values
# NEVER commit .env.prod to git

# ─── Database (externa — tu PostgreSQL ya existente en el LXC) ───────────────
# Opciones según dónde esté tu Postgres:
#   - En el host del LXC (fuera de Docker): postgresql://user:pass@host.docker.internal:5432/volta_db
#   - En otro contenedor Docker:            postgresql://user:pass@nombre-contenedor:5432/volta_db
#   - En otra IP de red:                   postgresql://user:pass@192.168.x.x:5432/volta_db
DATABASE_URL=postgresql://tu_usuario:tu_password@host.docker.internal:5432/volta_db?schema=public


# ─── App ─────────────────────────────────────────────────────────────────────
API_KEY=CHANGE_ME_RANDOM_API_KEY
PORT=3001

# ─── Auth (NextAuth / Auth.js) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_RUN_openssl_rand_base64_32

# ─── Frontend public URL ─────────────────────────────────────────────────────
# This is the public URL where the app is accessible (used in LOPD links etc.)
FRONTEND_URL=https://volta.kore29.com

# ─── Cloudflare Tunnel ───────────────────────────────────────────────────────
# El Token de tu túnel gestionado desde el panel de Cloudflare Zero Trust
CLOUDFLARE_TUNNEL_TOKEN=tu_token_aqui

