# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
*.pem

# Prisma
# El patrón contiene una barra, así que Git lo ancla a la raíz del repo y no
# cubre los workspaces. Se listan explícitamente para que el cliente generado
# no vuelva a versionarse: es un artefacto de build (schema.prisma lo declara
# como output) y versionarlo provoca bloqueos de fichero al cambiar de rama.
src/generated/
backend/src/generated/

# WhatsApp Web JS
.wwebjs_auth/
.wwebjs_cache/

# Testing
coverage/

# Editor/IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Docker
.docker/

# Turbopack
.turbo/
