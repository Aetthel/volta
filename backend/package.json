{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "_comment_exports": "El mapa apunta al fuente, no a un build: si un servicio se migra a TypeScript hay que actualizar aquí su extensión. Turbopack NO remapea .js->.ts en los destinos de un exports map, y un desajuste tumba la ruta del proxy entera con 'Module not found'.",
  "exports": {
    "./db": "./src/config/db.ts",
    "./bot": "./src/services/botService.ts",
    "./whatsapp": "./src/services/whatsappService.ts",
    "./auth-security": "./src/services/authSecurityService.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm prisma:generate",
    "start": "tsx src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --accept-data-loss",
    "lint": "echo 'No linting configured for backend'",
    "test": "vitest run",
    "test:load": "node src/tests/load/concurrencyTest.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.0.0",
    "autocannon": "^8.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
