generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  DEMO_SANDBOX
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Business {
  id                         String                @id @default(uuid())
  name                       String
  phone                      String // Teléfono comercial para vincular WhatsApp
  email                      String? // Email de contacto
  address                    String? // Dirección comercial
  logoUrl                    String? // URL del logo
  coverUrl                   String? // URL de foto del negocio
  description                String? // Descripción
  welcomeMessage             String? // Plantilla de mensaje de bienvenida
  reminderMessage            String? // Plantilla de mensaje de recordatorio
  whatsappStatus             WhatsAppStatus        @default(DISCONNECTED)
  qrCode                     String? // Código QR para vinculación
  themeColor                 String                @default("CLINICAL_ELEGANCE")
  fontSizeLevel              String                @default("MEDIUM")
  borderRadiusLevel          String                @default("MEDIUM")
  businessType               String? // p.ej. Peluquería, Estética, Veterinaria
  enablePublicBooking        Boolean               @default(true)
  subscriptionPlan           SubscriptionPlan      @default(PRO)
  subscriptionStatus         SubscriptionStatus    @default(TRIALING)
  trialExpiresAt             DateTime?
  sandboxExpiresAt           DateTime?
  gracePeriodExpiresAt       DateTime?
  cancelAtPeriodEnd          Boolean               @default(false)
  lemonSqueezyCustomerId     String?
  lemonSqueezySubscriptionId String?
  appointments               Appointment[]
  clients                    Client[]
  hours                      BusinessHours[]
  holidays                   BusinessHoliday[]
  services                   Service[]
  users                      User[]
  lopdConsentLogs            LopdConsentLog[]
  invoices                   Invoice[]
  bookingVerifications       BookingVerification[]
  alerts                     Alert[]
  classSchedules             ClassSchedule[]
}

enum UserRole {
  ADMIN
  JEFE
  EMPLEADO
}

/// Ciclo de vida de la cuenta. Es la fuente de verdad de "¿puede entrar?":
/// `emailVerified` sigue siendo el registro de auditoría de la prueba del correo,
/// pero quien decide el acceso en `authorize()` es este campo.
///
/// El valor por defecto es ACTIVE a propósito. Sólo el alta pública
/// (`registerUser`) nace en PENDING_VERIFICATION; los empleados que crea un JEFE
/// y el admin inicial no pasan por el flujo de OTP, y un default pendiente los
/// dejaría encerrados fuera de su propio panel.
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  password               String // Hashed password
  role                   UserRole  @default(EMPLEADO)
  businessId             String?
  business               Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status                 UserStatus @default(ACTIVE)
  emailVerified          Boolean   @default(false)
  emailVerifiedAt        DateTime?
  otpCode                String?
  otpExpiresAt           DateTime?
  otpAttempts            Int       @default(0)
  // Token de un solo uso que canjea la pantalla de verificación por una sesión,
  // para no volver a pedir la contraseña recién introducida en el registro.
  // Se guarda hasheado en SHA-256; el original sólo viaja en la respuesta del OTP.
  verificationLoginToken     String?
  verificationLoginExpiresAt DateTime?
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?
  twoFactorBackupCodes   String[]  @default([])
  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  alerts                 Alert[]

  @@index([businessId])
  @@index([businessId, role])
  @@index([resetPasswordToken])
  @@index([verificationLoginToken])
}

enum WhatsAppStatus {
  CONNECTED
  DISCONNECTED
  WAITING_QR
}

model Client {
  id              String           @id @default(uuid())
  name            String
  surname         String
  email           String?
  phone           String // Forma canónica de normalizePhone (dígitos, sin prefijo 34)
  lastVisit       DateTime? // Cambiado a DateTime nativo
  frequentService String?
  lopdStatus      String           @default("Pendiente")
  avatarUrl       String?
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  lopdConsentLogs LopdConsentLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, lopdStatus])
  @@index([businessId])
}

enum ServiceType {
  INDIVIDUAL
  GROUP
}

model Appointment {
  id              String            @id @default(uuid())
  clientName      String
  clientPhone     String
  appointmentDate DateTime
  status          AppointmentStatus @default(PENDING)
  attended        Boolean           @default(true)
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  serviceId       String?
  service         Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName     String?
  /// Cuando la sesión nace de una clase semanal, apunta a su programación.
  /// SetNull a propósito: borrar la programación no debe borrar el histórico.
  classScheduleId String?
  classSchedule   ClassSchedule?    @relation(fields: [classScheduleId], references: [id], onDelete: SetNull)

  @@index([businessId, appointmentDate])
  @@index([businessId, status])
  @@index([businessId, clientId])
  @@index([businessId, serviceId])
  @@index([clientId])
  @@index([serviceId])
  /// Una sesión por programación e instante: hace idempotente la materialización
  /// del horizonte aunque dos peticiones la disparen a la vez. Las citas sueltas
  /// llevan classScheduleId nulo y en Postgres los nulos no colisionan entre sí.
  @@unique([classScheduleId, appointmentDate])
}

enum AppointmentStatus {
  PENDING
  SENT
  ERROR
}

/**
 * Excepciones del negocio al catálogo de festivos españoles.
 *
 * Solo se guarda lo que se aparta del comportamiento por defecto (nacionales
 * cerrados, autonómicos abiertos), así que un negocio recién creado no necesita
 * ninguna fila: `isObserved = false` sobre un nacional significa "ese día abro",
 * y `true` sobre un autonómico, "este festivo me aplica".
 */
model BusinessHoliday {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  holidayKey String // Clave del catálogo: NAVIDAD, SAN_JUAN, VIERNES_SANTO...
  isObserved Boolean

  @@unique([businessId, holidayKey])
  @@index([businessId])
}

model BusinessHours {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Domingo, 1 = Lunes, etc.
  openTime   String // e.g., "09:00"
  closeTime  String // e.g., "20:00"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Service {
  id           String        @id @default(uuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  duration     Int // Duración en minutos
  price        Decimal       @db.Decimal(10, 2)
  type         ServiceType   @default(INDIVIDUAL)
  capacity     Int           @default(1)
  color        String        @default("TEAL")
  isActive     Boolean       @default(true)
  appointments Appointment[]
  schedules    ClassSchedule[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([businessId])
  @@index([businessId, isActive])
}

/**
 * Clase de grupo que se repite siempre en los mismos días y hora ("los martes a
 * las 11:30").
 *
 * La programación es la fuente de verdad y las sesiones concretas se
 * materializan como filas de Appointment hasta un horizonte móvil, para que todo
 * lo que ya funciona sobre citas —agenda, arrastrar y soltar, aforo,
 * recordatorios de WhatsApp, reserva online— siga funcionando sin cambios.
 *
 * `generatedUntil` es la marca de agua de esa materialización: solo se crean
 * sesiones posteriores a ella, así que borrar una sesión suelta no la resucita
 * en la siguiente extensión del horizonte.
 */
model ClassSchedule {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  daysOfWeek     Int[] // Convenio de Date.getDay(): 0 = Domingo, 1 = Lunes...
  startTime      String // "11:30", hora local del negocio
  startDate      DateTime // Primer día en que la clase empieza a aplicar
  endDate        DateTime? // null = repetición indefinida
  /// Si el grupo fijo de alumnos se copia en cada sesión o cada semana nace vacía.
  repeatClients  Boolean       @default(true)
  /// Grupo fijo de alumnos: [{ name, phone?, clientId? }]
  attendees      Json?
  isActive       Boolean       @default(true)
  generatedUntil DateTime?
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId, isActive])
  @@index([serviceId])
}

enum AlertType {
  EMERGENTE
  AVISO
  NOTIFICACION
}

enum AlertCategory {
  APPOINTMENT
  WHATSAPP
  CLIENT
  BILLING
  SYSTEM
}

model Alert {
  id          String        @id @default(uuid())
  type        AlertType
  category    AlertCategory @default(SYSTEM)
  title       String
  description String
  actionUrl   String?
  actionLabel String?
  isRead      Boolean       @default(false)
  isArchived  Boolean       @default(false)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String?
  business    Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([businessId])
  @@index([businessId, category])
  @@index([isArchived])
}

model LopdConsentLog {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  acceptedAt    DateTime @default(now())
  ipAddress     String
  userAgent     String
  policyVersion String   @default("1.0")

  @@index([clientId])
  @@index([businessId])
  @@index([businessId, clientId])
}

enum InvoiceStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

model Invoice {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lemonSqueezyId String?       @unique
  invoiceNumber  String
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("EUR")
  status         InvoiceStatus @default(PAID)
  invoiceUrl     String?
  billingReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
}

// Verificación por código de un solo uso del teléfono con el que un visitante
// accede al portal público de reservas. Se purga a las 24h (ver cron de limpieza).
model BookingVerification {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phone       String // Forma canónica de normalizePhone
  pendingName String? // Nombre aportado cuando el teléfono no era cliente todavía
  codeHash    String // HMAC-SHA256 del código; nunca se almacena en claro
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([businessId, phone])
  @@index([businessId, phone, createdAt])
  @@index([expiresAt])
}
