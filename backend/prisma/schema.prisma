generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id              String         @id @default(uuid())
  name            String
  phone           String         // Business phone for WhatsApp linkage
  email           String         @unique
  password        String         // Hashed password
  role            BusinessRole   @default(BUSINESS)
  address         String?        // Commercial address
  logoUrl         String?        // Profile photo URL
  coverUrl        String?        // Business photo URL
  description     String?        // About you description
  ownerName       String?        // Owner / Professional name
  welcomeMessage  String?        // Custom welcome message template
  reminderMessage String?        // Custom reminder message template
  whatsappStatus  WhatsAppStatus @default(DISCONNECTED)
  qrCode          String?        // Current QR code for pairing
  appointments    Appointment[]
  clients         Client[]
  hours           BusinessHours[]
  services        Service[]
}

enum BusinessRole {
  ADMIN
  BUSINESS
}

enum WhatsAppStatus {
  CONNECTED
  DISCONNECTED
  WAITING_QR
}

model Client {
  id              String         @id @default(uuid())
  name            String
  surname         String
  email           String?
  phone           String         // International format
  lastVisit       String?
  frequentService String?
  lopdStatus      String         @default("Pendiente") // "Aceptado" or "Pendiente"
  avatarUrl       String?
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id])
  appointments    Appointment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([businessId])
}

model Appointment {
  id              String           @id @default(uuid())
  clientName      String
  clientPhone     String           // International format (e.g., 34600000000)
  appointmentDate DateTime
  status          AppointmentStatus @default(PENDING)
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id])
  clientId        String?
  client          Client?          @relation(fields: [clientId], references: [id])
  serviceId       String?
  service         Service?         @relation(fields: [serviceId], references: [id])
  serviceName     String?

  @@index([businessId])
  @@index([clientId])
  @@index([serviceId])
}

enum AppointmentStatus {
  PENDING
  SENT
  ERROR
}

model BusinessHours {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Domingo, 1 = Lunes, etc.
  openTime   String   // e.g., "09:00"
  closeTime  String   // e.g., "20:00"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Service {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  duration    Int           // Duration in minutes
  price       Float         // Price in Euros
  isActive    Boolean       @default(true)
  appointments Appointment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([businessId])
}
