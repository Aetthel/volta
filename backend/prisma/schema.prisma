generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  DEMO_SANDBOX
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Business {
  id                         String                @id @default(uuid())
  name                       String
  phone                      String // Teléfono comercial para vincular WhatsApp
  email                      String? // Email de contacto
  address                    String? // Dirección comercial
  logoUrl                    String? // URL del logo
  coverUrl                   String? // URL de foto del negocio
  description                String? // Descripción
  welcomeMessage             String? // Plantilla de mensaje de bienvenida
  reminderMessage            String? // Plantilla de mensaje de recordatorio
  whatsappStatus             WhatsAppStatus        @default(DISCONNECTED)
  qrCode                     String? // Código QR para vinculación
  themeColor                 String                @default("CLINICAL_ELEGANCE")
  fontSizeLevel              String                @default("MEDIUM")
  borderRadiusLevel          String                @default("MEDIUM")
  businessType               String? // p.ej. Peluquería, Estética, Veterinaria
  enablePublicBooking        Boolean               @default(true)
  subscriptionPlan           SubscriptionPlan      @default(PRO)
  subscriptionStatus         SubscriptionStatus    @default(TRIALING)
  trialExpiresAt             DateTime?
  sandboxExpiresAt           DateTime?
  gracePeriodExpiresAt       DateTime?
  cancelAtPeriodEnd          Boolean               @default(false)
  lemonSqueezyCustomerId     String?
  lemonSqueezySubscriptionId String?
  appointments               Appointment[]
  clients                    Client[]
  hours                      BusinessHours[]
  services                   Service[]
  users                      User[]
  lopdConsentLogs            LopdConsentLog[]
  invoices                   Invoice[]
  bookingVerifications       BookingVerification[]
}

enum UserRole {
  ADMIN
  JEFE
  EMPLEADO
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String // Hashed password
  role       UserRole  @default(EMPLEADO)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  alerts     Alert[]

  @@index([businessId])
  @@index([businessId, role])
}

enum WhatsAppStatus {
  CONNECTED
  DISCONNECTED
  WAITING_QR
}

model Client {
  id              String           @id @default(uuid())
  name            String
  surname         String
  email           String?
  phone           String // Forma canónica de normalizePhone (dígitos, sin prefijo 34)
  lastVisit       DateTime? // Cambiado a DateTime nativo
  frequentService String?
  lopdStatus      String           @default("Pendiente")
  avatarUrl       String?
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  lopdConsentLogs LopdConsentLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, lopdStatus])
  @@index([businessId])
}

enum ServiceType {
  INDIVIDUAL
  GROUP
}

model Appointment {
  id              String            @id @default(uuid())
  clientName      String
  clientPhone     String
  appointmentDate DateTime
  status          AppointmentStatus @default(PENDING)
  attended        Boolean           @default(true)
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  serviceId       String?
  service         Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName     String?

  @@index([businessId, appointmentDate])
  @@index([businessId, status])
  @@index([businessId, clientId])
  @@index([businessId, serviceId])
  @@index([clientId])
  @@index([serviceId])
}

enum AppointmentStatus {
  PENDING
  SENT
  ERROR
}

model BusinessHours {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Domingo, 1 = Lunes, etc.
  openTime   String // e.g., "09:00"
  closeTime  String // e.g., "20:00"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Service {
  id           String        @id @default(uuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  duration     Int // Duración en minutos
  price        Decimal       @db.Decimal(10, 2)
  type         ServiceType   @default(INDIVIDUAL)
  capacity     Int           @default(1)
  color        String        @default("TEAL")
  isActive     Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([businessId])
  @@index([businessId, isActive])
}

enum AlertType {
  EMERGENTE
  AVISO
  NOTIFICACION
}

model Alert {
  id          String    @id @default(uuid())
  type        AlertType
  title       String
  description String
  isRead      Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isRead])
}

model LopdConsentLog {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  acceptedAt    DateTime @default(now())
  ipAddress     String
  userAgent     String
  policyVersion String   @default("1.0")

  @@index([clientId])
  @@index([businessId])
  @@index([businessId, clientId])
}

enum InvoiceStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

model Invoice {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lemonSqueezyId String?       @unique
  invoiceNumber  String
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("EUR")
  status         InvoiceStatus @default(PAID)
  invoiceUrl     String?
  billingReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
}

// Verificación por código de un solo uso del teléfono con el que un visitante
// accede al portal público de reservas. Se purga a las 24h (ver cron de limpieza).
model BookingVerification {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phone       String // Forma canónica de normalizePhone
  pendingName String? // Nombre aportado cuando el teléfono no era cliente todavía
  codeHash    String // HMAC-SHA256 del código; nunca se almacena en claro
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([businessId, phone])
  @@index([businessId, phone, createdAt])
  @@index([expiresAt])
}
