generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  DEMO_SANDBOX
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Business {
  id                  String             @id @default(uuid())
  name                String
  phone               String // Business phone for WhatsApp linkage
  email               String? // Contact email
  address             String? // Commercial address
  logoUrl             String? // Profile photo URL
  coverUrl            String? // Business photo URL
  description         String? // About you description
  welcomeMessage      String? // Custom welcome message template
  reminderMessage     String? // Custom reminder message template
  whatsappStatus      WhatsAppStatus     @default(DISCONNECTED)
  qrCode              String? // Current QR code for pairing
  themeColor          String             @default("CLINICAL_ELEGANCE")
  fontSizeLevel       String             @default("MEDIUM")
  borderRadiusLevel   String             @default("MEDIUM")
  businessType        String? // e.g. Peluquería / Barbería, Estética, etc.
  enablePublicBooking Boolean            @default(true)
  subscriptionPlan    SubscriptionPlan   @default(PRO)
  subscriptionStatus  SubscriptionStatus @default(TRIALING)
  trialExpiresAt      DateTime?
  sandboxExpiresAt    DateTime?
  appointments        Appointment[]
  clients             Client[]
  hours               BusinessHours[]
  services            Service[]
  users               User[]
  lopdConsentLogs     LopdConsentLog[]
}

enum UserRole {
  ADMIN
  JEFE
  EMPLEADO
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String // Hashed password
  role       UserRole  @default(EMPLEADO)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  alerts     Alert[]

  @@index([businessId])
}

enum WhatsAppStatus {
  CONNECTED
  DISCONNECTED
  WAITING_QR
}

model Client {
  id              String           @id @default(uuid())
  name            String
  surname         String
  email           String?
  phone           String // International format
  lastVisit       String?
  frequentService String?
  lopdStatus      String           @default("Pendiente") // "Aceptado" or "Pendiente"
  avatarUrl       String?
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  lopdConsentLogs LopdConsentLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([businessId])
}

model Appointment {
  id              String            @id @default(uuid())
  clientName      String
  clientPhone     String // International format (e.g., 34600000000)
  appointmentDate DateTime
  status          AppointmentStatus @default(PENDING)
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id])
  serviceId       String?
  service         Service?          @relation(fields: [serviceId], references: [id])
  serviceName     String?

  @@index([businessId])
  @@index([clientId])
  @@index([serviceId])
}

enum AppointmentStatus {
  PENDING
  SENT
  ERROR
}

model BusinessHours {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Domingo, 1 = Lunes, etc.
  openTime   String // e.g., "09:00"
  closeTime  String // e.g., "20:00"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Service {
  id           String        @id @default(uuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  duration     Int // Duration in minutes
  price        Decimal       @db.Decimal(10, 2) // Price in Euros
  capacity     Int           @default(1) // Max participants per session
  isActive     Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([businessId])
}

enum AlertType {
  EMERGENTE
  AVISO
  NOTIFICACION
}

model Alert {
  id          String    @id @default(uuid())
  type        AlertType
  title       String
  description String
  isRead      Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model LopdConsentLog {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  acceptedAt    DateTime @default(now())
  ipAddress     String
  userAgent     String
  policyVersion String   @default("1.0")

  @@index([clientId])
  @@index([businessId])
}
